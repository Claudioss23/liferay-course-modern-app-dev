INSERT INTO FRAGMENTENTRYLINK VALUES(7,0,'d2871e88-121a-4981-1701-a3fc76ebdd13',73262,32106,16796623585306,20122,'Clarity Admin','2025-08-13 17:57:52.326000','2026-04-21 14:19:44.790000',0,0,73222,20031,143,143,'.component-html img {\u000a\u0009max-width: 100%;\u000a}','<div class="component-html" data-lfr-editable-id="element-html" data-lfr-editable-type="html">\u000a\u0009<h1>HTML Example</h1>\u000a\u000a\u0009<p class="mb-0">\u000a\u0009\u0009A paragraph is a <strong>self-contained</strong> unit of a discourse in\u000a\u0009\u0009writing dealing with a particular point or <em>idea</em>. Paragraphs are\u000a\u0009\u0009usually an expected part of formal writing, used to organize longer\u000a\u0009\u0009prose.\u000a\u0009</p>\u000a</div>','','','0','{"com.liferay.fragment.entry.processor.editable.EditableFragmentEntryProcessor":{"element-html":{"defaultValue":"\n\t<h1>HTML Example<\/h1>\n\n\t<p class=\"mb-0\">\n\t\tA paragraph is a <strong>self-contained<\/strong> unit of a discourse in\n\t\twriting dealing with a particular point or <em>idea<\/em>. Paragraphs are\n\t\tusually an expected part of formal writing, used to organize longer\n\t\tprose.\n\t<\/p>\n","en_US":"<p class=\"mb-0\">\n \u00a9 2024 Clarity Vision Solutions, INC\n<\/p>","config":{}}}}','caja',0,'BASIC_COMPONENT-html',1,'2026-04-21 14:19:44.790000',NULL,'d2871e88-121a-4981-1701-a3fc76ebdd13')
